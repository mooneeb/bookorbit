{
  "operations": [
    "AuthController_loginOptions",
    "AuthController_login",
    "AuthController_refresh",
    "AuthController_logout",
    "AuthController_me"
  ],
  "schemas": {
    "OidcProviderSummary": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "iconUrl": {
          "type": "string",
          "nullable": true
        }
      },
      "required": ["slug", "displayName"]
    },
    "LoginOptions": {
      "type": "object",
      "properties": {
        "passwordLoginEnabled": {
          "type": "boolean"
        },
        "allowRegistration": {
          "type": "boolean"
        },
        "oidcProviders": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/OidcProviderSummary"
          }
        }
      },
      "required": ["passwordLoginEnabled", "oidcProviders"]
    },
    "AuthUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "username": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "isSuperuser": {
          "type": "boolean"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["id", "username", "name"]
    },
    "NativeCredentials": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "accessTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "refreshToken": {
          "type": "string"
        },
        "refreshTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "sessionId": {
          "type": "integer"
        }
      },
      "required": [
        "accessToken",
        "accessTokenExpiresAt",
        "refreshToken",
        "refreshTokenExpiresAt",
        "sessionId"
      ]
    },
    "NativeAuthResponse": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "accessTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "refreshToken": {
          "type": "string"
        },
        "refreshTokenExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "sessionId": {
          "type": "integer"
        },
        "user": {
          "$ref": "#/components/schemas/AuthUser"
        }
      },
      "required": [
        "accessToken",
        "accessTokenExpiresAt",
        "refreshToken",
        "refreshTokenExpiresAt",
        "sessionId",
        "user"
      ]
    }
  },
  "patches": {
    "AuthController_loginOptions": {
      "responses": {
        "200": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginOptions"
              }
            }
          }
        }
      }
    },
    "AuthController_login": {
      "responses": {
        "200": {
          "description": "Native clients receive both tokens in the body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NativeAuthResponse"
              }
            }
          }
        },
        "default": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiError"
              }
            }
          }
        }
      }
    },
    "AuthController_refresh": {
      "responses": {
        "200": {
          "description": "Native clients receive the rotated refresh token in the body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NativeCredentials"
              }
            }
          }
        },
        "default": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiError"
              }
            }
          }
        }
      }
    },
    "AuthController_me": {
      "responses": {
        "200": {
          "description": "",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthUser"
              }
            }
          }
        }
      }
    }
  }
}

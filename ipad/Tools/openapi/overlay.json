{
  "schemas": {
    "ApiError": {
      "type": "object",
      "properties": {
        "statusCode": { "type": "integer" },
        "message": { "type": "string" },
        "errorCode": { "type": "string" },
        "retryAfterSeconds": { "type": "integer" }
      },
      "required": ["statusCode", "message"]
    },
    "OidcProviderSummary": {
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "displayName": { "type": "string" },
        "iconUrl": { "type": "string", "nullable": true }
      },
      "required": ["slug", "displayName"]
    },
    "LoginOptions": {
      "type": "object",
      "properties": {
        "passwordLoginEnabled": { "type": "boolean" },
        "allowRegistration": { "type": "boolean" },
        "oidcProviders": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/OidcProviderSummary" }
        }
      },
      "required": ["passwordLoginEnabled", "oidcProviders"]
    },
    "AuthUser": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "isSuperuser": { "type": "boolean" },
        "permissions": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "username", "name"]
    },
    "NativeCredentials": {
      "type": "object",
      "properties": {
        "accessToken": { "type": "string" },
        "accessTokenExpiresAt": { "type": "string", "format": "date-time" },
        "refreshToken": { "type": "string" },
        "refreshTokenExpiresAt": { "type": "string", "format": "date-time" },
        "sessionId": { "type": "integer" }
      },
      "required": [
        "accessToken",
        "accessTokenExpiresAt",
        "refreshToken",
        "refreshTokenExpiresAt",
        "sessionId"
      ]
    },
    "NativeAuthResponse": {
      "type": "object",
      "properties": {
        "accessToken": { "type": "string" },
        "accessTokenExpiresAt": { "type": "string", "format": "date-time" },
        "refreshToken": { "type": "string" },
        "refreshTokenExpiresAt": { "type": "string", "format": "date-time" },
        "sessionId": { "type": "integer" },
        "user": { "$ref": "#/components/schemas/AuthUser" }
      },
      "required": [
        "accessToken",
        "accessTokenExpiresAt",
        "refreshToken",
        "refreshTokenExpiresAt",
        "sessionId",
        "user"
      ]
    },
    "SortSpec": {
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "dir": { "type": "string", "enum": ["asc", "desc"] }
      },
      "required": ["field", "dir"]
    },
    "BookQuery": {
      "type": "object",
      "properties": {
        "sort": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/SortSpec" }
        },
        "pagination": {
          "type": "object",
          "properties": {
            "page": { "type": "integer" },
            "size": { "type": "integer" }
          },
          "required": ["page", "size"]
        },
        "q": { "type": "string" }
      },
      "required": ["sort", "pagination"]
    },
    "BookFileRef": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "format": { "type": "string", "nullable": true },
        "role": { "type": "string" }
      },
      "required": ["id", "role"]
    },
    "BookCard": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "title": { "type": "string", "nullable": true },
        "authors": { "type": "array", "items": { "type": "string" } },
        "hasCover": { "type": "boolean" },
        "coverVersion": { "type": "string" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/BookFileRef" }
        }
      },
      "required": ["id", "authors", "hasCover", "coverVersion", "files"]
    },
    "BooksPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/BookCard" }
        },
        "total": { "type": "integer" },
        "page": { "type": "integer" },
        "size": { "type": "integer" }
      },
      "required": ["items", "total", "page", "size"]
    }
  },
  "operations": {
    "AuthController_loginOptions": {
      "responses": {
        "200": {
          "description": "",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginOptions" }
            }
          }
        }
      }
    },
    "AuthController_login": {
      "responses": {
        "200": {
          "description": "Native clients receive both tokens in the body",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NativeAuthResponse" }
            }
          }
        },
        "default": {
          "description": "",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApiError" }
            }
          }
        }
      }
    },
    "AuthController_refresh": {
      "responses": {
        "200": {
          "description": "Native clients receive the rotated refresh token in the body",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NativeCredentials" }
            }
          }
        },
        "default": {
          "description": "",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApiError" }
            }
          }
        }
      }
    },
    "AuthController_me": {
      "responses": {
        "200": {
          "description": "",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthUser" }
            }
          }
        }
      }
    },
    "BookController_globalQuery": {
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/BookQuery" }
          }
        }
      },
      "responses": {
        "201": {
          "description": "",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BooksPage" }
            }
          }
        }
      }
    }
  }
}
